#!/usr/bin/env python3
"""Create a Project Euler problem notebook with preset structure.

Usage: ./mkprob <problem_number>
"""

import json
import os
import re
import sys
import urllib.request
import uuid

RANGES = [
    (1, 100), (101, 200), (201, 300), (301, 400), (401, 500),
    (601, 700), (701, 800), (801, 900), (901, 1000),
]


def _dir(n):
    for lo, hi in RANGES:
        if lo <= n <= hi:
            return f"{lo}-{hi}"
    return None


def _fetch_title(n):
    try:
        url = f"https://projecteuler.net/problem={n}"
        req = urllib.request.Request(url, headers={"User-Agent": "mkprob/1.0"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            m = re.search(r'<h2>(.+?)</h2>', resp.read().decode())
            if m:
                return m.group(1)
    except Exception:
        pass
    return None


def _make_cell(cell_type, source, cell_id=None):
    cell = {
        "cell_type": cell_type,
        "id": cell_id or str(uuid.uuid4()),
        "metadata": {},
    }
    if cell_type == "code":
        cell["execution_count"] = None
        cell["outputs"] = []
    cell["source"] = source if isinstance(source, list) else [source]
    return cell


def make(n):
    d = _dir(n)
    if d is None:
        print(f"Unsupported problem number: {n}", file=sys.stderr)
        sys.exit(1)

    os.makedirs(d, exist_ok=True)
    path = os.path.join(d, f"{n:04d}.ipynb")

    if os.path.exists(path):
        print(f"Already exists: {path}")
        return

    title = _fetch_title(n)
    heading = f"# {title}" if title else f"# Problem {n}"

    notebook = {
        "cells": [
            _make_cell("markdown", [heading + "\n"]),
            _make_cell("markdown", "## Solution.\n"),
            _make_cell("code", [], "scratch-1"),
            _make_cell("code", [], "scratch-2"),
            _make_cell("code", [], "scratch-3"),
        ],
        "metadata": {
            "kernelspec": {
                "display_name": "Python 3",
                "language": "python",
                "name": "python3",
            },
            "language_info": {
                "name": "python",
                "version": ".".join(map(str, sys.version_info[:3])),
            },
        },
        "nbformat": 4,
        "nbformat_minor": 5,
    }

    with open(path, "w") as f:
        json.dump(notebook, f, indent=1)
        f.write("\n")

    print(f"Created: {path}")


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: mkprob <problem_number>", file=sys.stderr)
        sys.exit(1)
    make(int(sys.argv[1]))